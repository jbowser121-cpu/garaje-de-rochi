# Copia este archivo como .env y completa los valores.

# --- Tienda ---
PORT=3000

# --- Panel de moderador (http://localhost:3000/admin.html) ---
# CAMBIA estas credenciales por unas tuyas antes de usar en producción.
ADMIN_USER=admin
ADMIN_PASS=rochi123

# --- Bots (URL de la API de la tienda que consultan) ---
API_URL=http://localhost:3000

# --- Opiniones de clientes (Supabase) ---
# Para que las opiniones se guarden y se muestren en /opiniones.
# Crea un proyecto en https://supabase.com, crea la tabla "opiniones" (ver README)
# y copia aquí la URL del proyecto y la clave service_role (Project Settings > API).
# La clave service_role es SECRETA: solo va en el servidor, nunca en el navegador.
# EN EL PC: el bot de WhatsApp (bots/whatsapp.js) también usa estas dos variables para
# enviarle al cliente el WhatsApp de opinión tras su compra (tabla "cola_whatsapp").
SUPABASE_URL=
SUPABASE_KEY=

# --- Instagram (Meta Graph API) ---
# Token que TÚ inventas y registras en el webhook de Meta:
IG_VERIFY_TOKEN=nutrivida_verify
# Token de acceso de la Página de Facebook vinculada a la cuenta de Instagram:
IG_PAGE_ACCESS_TOKEN=
IG_PORT=3100

# WhatsApp (whatsapp-web.js) no necesita claves: se conecta por QR.

# --- Claude (respuestas con IA en los bots) ---
# Opcional. Si la dejas vacía, los bots responden por reglas (gratis).
# Saca la clave en https://console.anthropic.com > API Keys
ANTHROPIC_API_KEY=
# Modelo (opcional). Por defecto claude-opus-5.
ANTHROPIC_MODEL=claude-opus-5

# --- Pago con Wompi (PSE / tarjeta débito o crédito) ---
# Regístrate en https://comercios.wompi.co y vincula tu cuenta bancaria (ahí llega el dinero).
# Copia tus llaves (Ajustes > Llaves API). El secreto de integridad nunca se comparte.
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
